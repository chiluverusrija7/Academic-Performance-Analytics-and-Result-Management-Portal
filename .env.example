# ============================================================
# EduInsight AI — Environment Configuration Template
# ============================================================

# Database Configuration (PostgreSQL + pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=EduInsight
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/EduInsight

# FastAPI AI Service Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_BASE_URL=http://localhost:8000

# Express Backend Configuration
PORT=5000
BACKEND_URL=http://localhost:5000

# Flask Web Application Configuration
FLASK_APP=flask_app/app.py
FLASK_ENV=development
FLASK_PORT=5001
FLASK_SECRET_KEY=eduinsight_super_secure_flask_session_key_2026

# JWT Security Configuration
JWT_SECRET_KEY=eduinsight_production_jwt_secret_signing_key_2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# pgvector Embedding Model Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DIMENSION=384
